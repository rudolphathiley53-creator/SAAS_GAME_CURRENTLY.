# Copy this file to .env.local for local development.
# Replace the placeholder public key with the publishable key from Supabase.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-publishable-key

# Never add service_role or provider secrets to NEXT_PUBLIC_* variables.
# No server-side privileged key is needed for the public foundation.
